# Server
PORT=3000
NODE_ENV=development

# PostgreSQL connection string
DATABASE_URL=postgres://user:password@localhost:5432/basecode

# Auth.js secret, minimum 32 chars: openssl rand -hex 32
AUTH_SECRET=

# Comma-separated list of origins allowed by CORS (empty = same-origin only)
CORS_ORIGINS=http://localhost:3000

# Log level for pino (trace|debug|info|warn|error)
LOG_LEVEL=info
